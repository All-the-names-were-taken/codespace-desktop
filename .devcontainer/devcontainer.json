{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "forwardPorts": [6080],
  "runArgs": [
    "--cap-add=SYS_ADMIN"
  ],
  "postCreateCommand": "git clone https://github.com/novnc/noVNC.git && git clone https://github.com/novnc/websockify /websockify",
  "postStartCommand": "vncserver -geometry 1280x720 -depth 24 && /workspaces/${localWorkspaceFolderBasename}/noVNC/utils/novnc_proxy --vnc localhost:5901 --listen 0.0.0.0:6080"
}
