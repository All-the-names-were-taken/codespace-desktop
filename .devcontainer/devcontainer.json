{
  "name": "AndixSH XFCE",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "overrideCommand": true,
  "command": "bash .devcontainer/start-desktop.sh"
}
